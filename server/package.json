{
  "name": "roster-dashboard-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.2.7",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "roster-dashboard": "file:.."
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
